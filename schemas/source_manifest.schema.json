{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/source_manifest.schema.json",
  "title": "AggregateSourceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "dataset_id", "sources", "synthetic"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "publisher",
          "locator",
          "content_sha256",
          "license_id",
          "acquired_on",
          "synthetic"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["embedded_fixture", "https_url", "opaque_private_id"]
              },
              "value": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {
                "if": {
                  "properties": {"kind": {"const": "https_url"}},
                  "required": ["kind"]
                },
                "then": {
                  "properties": {"value": {"pattern": "^https://"}}
                }
              },
              {
                "if": {
                  "properties": {"kind": {"const": "opaque_private_id"}},
                  "required": ["kind"]
                },
                "then": {
                  "properties": {
                    "value": {
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {"kind": {"const": "embedded_fixture"}},
                  "required": ["kind"]
                },
                "then": {
                  "properties": {"value": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}}
                }
              }
            ]
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "license_id": {"type": "string", "minLength": 1},
          "acquired_on": {
            "type": ["string", "null"],
            "format": "date"
          },
          "synthetic": {"type": "boolean"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"synthetic": {"const": true}},
              "required": ["synthetic"]
            },
            "then": {
              "properties": {
                "locator": {
                  "properties": {"kind": {"const": "embedded_fixture"}}
                }
              }
            },
            "else": {
              "properties": {
                "locator": {
                  "properties": {
                    "kind": {"enum": ["https_url", "opaque_private_id"]}
                  }
                },
                "acquired_on": {"type": "string", "format": "date"}
              }
            }
          }
        ]
      }
    },
    "synthetic": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"synthetic": {"const": true}},
        "required": ["synthetic"]
      },
      "then": {
        "properties": {
          "sources": {
            "items": {"properties": {"synthetic": {"const": true}}}
          }
        }
      },
      "else": {
        "properties": {
          "sources": {
            "items": {"properties": {"synthetic": {"const": false}}}
          }
        }
      }
    }
  ]
}

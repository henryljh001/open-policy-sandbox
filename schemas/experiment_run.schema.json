{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/experiment_run.schema.json",
  "title": "RepeatedExperimentRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "scenario_id",
    "scenario_version",
    "input_digest",
    "engine",
    "base_seed",
    "repetitions",
    "successful_runs",
    "failed_runs",
    "failure_rate",
    "failure_reasons",
    "outcome_summary",
    "group_summary",
    "warnings",
    "reproducible",
    "synthetic"
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "std", "p05", "p50", "p95"],
      "properties": {
        "mean": {"type": "number"},
        "std": {"type": "number", "minimum": 0},
        "p05": {"type": "number"},
        "p50": {"type": "number"},
        "p95": {"type": "number"}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_version": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "base_seed": {"type": "integer", "minimum": 0},
    "repetitions": {"type": "integer", "minimum": 2},
    "successful_runs": {"type": "integer", "minimum": 0},
    "failed_runs": {"type": "integer", "minimum": 0},
    "failure_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "failure_reasons": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "outcome_summary": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/summary"}
    },
    "group_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"$ref": "#/$defs/summary"}
      }
    },
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "reproducible": {"type": "boolean"},
    "synthetic": {"const": true}
  }
}

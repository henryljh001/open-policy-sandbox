{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/aggregate_calibration_dataset.schema.json",
  "title": "SyntheticAggregateCalibrationDataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "data_card", "records", "synthetic"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "data_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "title",
        "publisher",
        "source_kind",
        "authorization",
        "license",
        "geography",
        "coverage",
        "transformations",
        "limitations",
        "synthetic"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "source_kind": {"const": "synthetic_fixture"},
        "authorization": {"const": "synthetic_fixture"},
        "license": {"type": "string", "minLength": 1},
        "geography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "region_id"],
          "properties": {
            "level": {"const": "synthetic_county"},
            "region_id": {"type": "string", "minLength": 1}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_year", "indicator_ids"],
          "properties": {
            "reference_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
            "indicator_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "transformations": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "synthetic": {"const": true}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "indicator_id",
          "value",
          "unit",
          "reference_year",
          "status",
          "synthetic"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "indicator_id": {
            "type": "string",
            "enum": [
              "total_population",
              "urbanization_rate",
              "employment_rate",
              "debt_to_revenue",
              "education_capacity_per_1000",
              "health_capacity_per_1000",
              "housing_occupancy_rate",
              "used_construction_land"
            ]
          },
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "reference_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
          "status": {"const": "synthetic_observation"},
          "synthetic": {"const": true}
        }
      }
    },
    "synthetic": {"const": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/comparison_run.schema.json",
  "title": "SyntheticScenarioComparisonRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "name",
    "comparison_mode",
    "status",
    "input_digest",
    "baseline_scenario_id",
    "scenario_order",
    "repetitions",
    "base_seed",
    "metric_catalog_version",
    "selected_metrics",
    "pareto_metrics",
    "scenario_summaries",
    "metric_comparison",
    "group_metric",
    "group_comparison",
    "group_disparities",
    "risk_thresholds",
    "resource_risk_ledger",
    "non_dominated_scenario_ids",
    "warnings",
    "reproducible",
    "usage_level",
    "synthetic"
  ],
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["info", "warning", "critical"]},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "comparison_id": {"type": "string", "minLength": 1},
    "name": {"type": "string"},
    "comparison_mode": {"type": "string", "enum": ["policy", "stress", "joint"]},
    "status": {"const": "succeeded"},
    "input_digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "baseline_scenario_id": {"type": "string", "minLength": 1},
    "scenario_order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "repetitions": {"type": "integer", "minimum": 2, "maximum": 1000},
    "base_seed": {"type": "integer", "minimum": 0},
    "metric_catalog_version": {"type": "string", "minLength": 1},
    "selected_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pareto_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "scenario_summaries": {"type": "object", "minProperties": 2},
    "metric_comparison": {"type": "object", "minProperties": 1},
    "group_metric": {"type": "string", "minLength": 1},
    "group_comparison": {"type": "object"},
    "group_disparities": {"type": "object"},
    "risk_thresholds": {"type": "object"},
    "resource_risk_ledger": {"type": "object"},
    "non_dominated_scenario_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "reproducible": {"const": true},
    "usage_level": {"const": "Demo"},
    "synthetic": {"const": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/commitment.schema.json",
  "title": "PolicyCommitment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commitment_id",
    "issuer",
    "geography",
    "indicator",
    "target",
    "evidence_ids",
    "verification_status",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "commitment_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "name"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["national", "province", "prefecture", "county", "community", "synthetic"]
        },
        "code": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_name", "controlled_id", "category"],
      "properties": {
        "raw_name": {"type": "string", "minLength": 1},
        "controlled_id": {"type": ["string", "null"]},
        "category": {
          "type": "string",
          "enum": ["economy", "innovation", "livelihood", "environment", "safety", "other"]
        }
      }
    },
    "baseline": {"$ref": "#/$defs/value_point"},
    "target": {"$ref": "#/$defs/target_point"},
    "attribute": {
      "type": "string",
      "enum": ["binding", "expected", "unknown"]
    },
    "commitment_type": {
      "type": "string",
      "enum": ["advance", "floor", "ceiling", "qualitative"]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verification_status": {
      "type": "string",
      "enum": ["candidate", "machine_verified", "human_verified", "rejected"]
    },
    "publication_allowed": {"type": "boolean", "default": false},
    "synthetic": {"type": "boolean"}
  },
  "$defs": {
    "value_point": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "unit", "year"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2200}
      }
    },
    "target_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "unit", "year", "semantics"],
      "properties": {
        "raw": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
        "year_inferred": {"type": "boolean", "default": false},
        "semantics": {
          "type": "string",
          "enum": [
            "endpoint_level",
            "annual_growth",
            "annual_relation",
            "cumulative_change",
            "period_total",
            "qualitative_target"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/domains/new_urbanization_scenario.schema.json",
  "title": "NewUrbanizationSyntheticScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "version",
    "domain_config",
    "archetype",
    "start_year",
    "baseline_rates",
    "engine",
    "random_seed",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "domain_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "focus_module",
        "spatial_scale",
        "time_step",
        "horizon_years",
        "county_type",
        "enabled_modules",
        "synthetic"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "domain": {"const": "new_urbanization"},
        "focus_module": {"const": "citizenization"},
        "spatial_scale": {"const": "county"},
        "time_step": {"const": "annual"},
        "horizon_years": {"type": "integer", "minimum": 1, "maximum": 15},
        "county_type": {
          "type": "string",
          "enum": [
            "metropolitan_adjacent",
            "specialized_function",
            "agricultural_main_production",
            "key_ecological_function",
            "population_losing"
          ]
        },
        "enabled_modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "population",
              "labor",
              "housing",
              "public_service",
              "fiscal",
              "land"
            ]
          }
        },
        "random_seed": {"type": "integer", "minimum": 0},
        "synthetic": {"const": true}
      }
    },
    "archetype": {
      "type": "string",
      "enum": [
        "metropolitan_adjacent",
        "specialized_function",
        "agricultural_main_production",
        "key_ecological_function",
        "population_losing"
      ]
    },
    "start_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "population_scale": {"type": "number", "exclusiveMinimum": 0},
    "baseline_rates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "birth_rate": {"type": "number", "minimum": 0, "maximum": 0.1},
        "death_rate": {"type": "number", "minimum": 0, "maximum": 0.1},
        "net_migration_rate": {"type": "number", "minimum": -0.1, "maximum": 0.1},
        "urbanization_change": {"type": "number", "minimum": -0.05, "maximum": 0.05},
        "hukou_conversion_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "working_age_share": {"type": "number", "minimum": 0, "maximum": 1},
        "employment_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "job_growth_rate": {"type": "number", "minimum": -0.2, "maximum": 0.2},
        "housing_growth_rate": {"type": "number", "minimum": 0, "maximum": 0.2},
        "affordable_share_of_new_housing": {"type": "number", "minimum": 0, "maximum": 1},
        "education_growth_rate": {"type": "number", "minimum": -0.1, "maximum": 0.2},
        "health_growth_rate": {"type": "number", "minimum": -0.1, "maximum": 0.2},
        "fiscal_revenue_growth_rate": {"type": "number", "minimum": -0.2, "maximum": 0.3},
        "transfer_growth_rate": {"type": "number", "minimum": -0.2, "maximum": 0.3},
        "operating_expenditure_growth_rate": {"type": "number", "minimum": -0.2, "maximum": 0.3},
        "capital_expenditure_share": {"type": "number", "minimum": 0, "maximum": 1},
        "construction_land_growth_rate": {"type": "number", "minimum": 0, "maximum": 0.1},
        "stock_land_reuse_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config"],
      "properties": {
        "name": {"const": "new_urbanization_baseline"},
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strict_invariants": {"type": "boolean"}
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "random_seed": {"type": "integer", "minimum": 0},
    "synthetic": {"const": true}
  }
}


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/domains/new_urbanization_comparison_plan.schema.json",
  "title": "NewUrbanizationSyntheticComparisonPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "name",
    "comparison_mode",
    "baseline_key",
    "context",
    "scenario_specs",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "comparison_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "comparison_mode": {"type": "string", "enum": ["policy", "stress", "joint"]},
    "baseline_key": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype",
        "start_year",
        "sample_size",
        "repetitions",
        "base_seed"
      ],
      "properties": {
        "archetype": {
          "type": "string",
          "enum": [
            "metropolitan_adjacent",
            "specialized_function",
            "agricultural_main_production",
            "key_ecological_function",
            "population_losing"
          ]
        },
        "start_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "sample_size": {"type": "integer", "minimum": 100, "maximum": 100000},
        "repetitions": {"type": "integer", "minimum": 2, "maximum": 1000},
        "base_seed": {"type": "integer", "minimum": 0},
        "horizon_years": {"type": "integer", "minimum": 1, "maximum": 15}
      }
    },
    "scenario_specs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "scenario_code", "pressures"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "maxLength": 64},
          "scenario_code": {
            "type": "string",
            "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"]
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "pressures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "employment_downturn",
                "fiscal_tightening",
                "migration_surge",
                "population_aging",
                "extreme_disruption"
              ]
            }
          }
        }
      }
    },
    "selected_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "risk_thresholds": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "synthetic": {"const": true}
  }
}

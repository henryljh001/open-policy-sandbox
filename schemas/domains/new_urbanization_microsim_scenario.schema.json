{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/domains/new_urbanization_microsim_scenario.schema.json",
  "title": "NewUrbanizationSyntheticMicrosimScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "version",
    "domain_config",
    "scenario_code",
    "archetype",
    "start_year",
    "baseline_rates",
    "policy_package",
    "pressure_package",
    "microsim_config",
    "engine",
    "random_seed",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "domain_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "focus_module",
        "spatial_scale",
        "time_step",
        "horizon_years",
        "county_type",
        "enabled_modules",
        "synthetic"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "domain": {"const": "new_urbanization"},
        "focus_module": {"const": "citizenization"},
        "spatial_scale": {"const": "county"},
        "time_step": {"const": "annual"},
        "horizon_years": {"type": "integer", "minimum": 1, "maximum": 15},
        "county_type": {
          "type": "string",
          "enum": [
            "metropolitan_adjacent",
            "specialized_function",
            "agricultural_main_production",
            "key_ecological_function",
            "population_losing"
          ]
        },
        "enabled_modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "population",
              "labor",
              "housing",
              "public_service",
              "fiscal",
              "land"
            ]
          }
        },
        "random_seed": {"type": "integer", "minimum": 0},
        "synthetic": {"const": true}
      }
    },
    "scenario_code": {
      "type": "string",
      "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"]
    },
    "archetype": {
      "type": "string",
      "enum": [
        "metropolitan_adjacent",
        "specialized_function",
        "agricultural_main_production",
        "key_ecological_function",
        "population_losing"
      ]
    },
    "start_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "population_scale": {"type": "number", "exclusiveMinimum": 0},
    "baseline_rates": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "policy_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "interventions", "synthetic"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "interventions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intervention_id", "name", "config"],
            "properties": {
              "intervention_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "config": {"type": "object"}
            }
          }
        },
        "synthetic": {"const": true}
      }
    },
    "pressure_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "pressures", "synthetic"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "pressures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pressure_id", "name", "config"],
            "properties": {
              "pressure_id": {"type": "string", "minLength": 1},
              "name": {
                "type": "string",
                "enum": [
                  "employment_downturn",
                  "fiscal_tightening",
                  "migration_surge",
                  "population_aging",
                  "extreme_disruption"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "intensity",
                  "synthetic_assumption",
                  "rate_deltas",
                  "behavior_deltas"
                ],
                "properties": {
                  "intensity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                  "synthetic_assumption": {"const": true},
                  "rate_deltas": {
                    "type": "object",
                    "additionalProperties": {"type": "number"}
                  },
                  "behavior_deltas": {
                    "type": "object",
                    "additionalProperties": {"type": "number"}
                  }
                }
              }
            }
          }
        },
        "synthetic": {"const": true}
      }
    },
    "microsim_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_size", "behavior", "synthetic"],
      "properties": {
        "sample_size": {"type": "integer", "minimum": 100, "maximum": 100000},
        "behavior": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["synthetic_targets", "targets"],
          "properties": {
            "synthetic_targets": {"const": true},
            "targets": {"type": "object"}
          }
        },
        "synthetic": {"const": true}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config"],
      "properties": {
        "name": {"const": "new_urbanization_microsim"},
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"strict_invariants": {"const": true}}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "random_seed": {"type": "integer", "minimum": 0},
    "synthetic": {"const": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/domains/new_urbanization.domain.schema.json",
  "title": "NewUrbanizationDomainConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "focus_module",
    "spatial_scale",
    "time_step",
    "horizon_years",
    "enabled_modules",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "domain": {"const": "new_urbanization"},
    "focus_module": {
      "type": "string",
      "enum": [
        "citizenization",
        "potential_region",
        "metropolitan_area",
        "urban_renewal_resilience",
        "integrated"
      ]
    },
    "spatial_scale": {
      "type": "string",
      "enum": ["county", "prefecture", "metropolitan_area", "province"]
    },
    "time_step": {"const": "annual"},
    "horizon_years": {"type": "integer", "minimum": 1, "maximum": 15},
    "county_type": {
      "type": ["string", "null"],
      "enum": [
        "metropolitan_adjacent",
        "specialized_function",
        "agricultural_main_production",
        "key_ecological_function",
        "population_losing",
        null
      ]
    },
    "enabled_modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "population",
          "labor",
          "housing",
          "public_service",
          "fiscal",
          "land",
          "mobility",
          "governance",
          "resilience"
        ]
      }
    },
    "random_seed": {"type": "integer", "minimum": 0},
    "synthetic": {"type": "boolean"}
  }
}

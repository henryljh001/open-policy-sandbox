{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/scenario.schema.json",
  "title": "PolicyScenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "name",
    "version",
    "commitment_ids",
    "baseline",
    "interventions",
    "engine",
    "random_seed",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "commitment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "baseline": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intervention_id", "plugin", "start_period", "parameters"],
        "properties": {
          "intervention_id": {"type": "string", "minLength": 1},
          "plugin": {"type": "string", "minLength": 1},
          "target_group": {"type": ["string", "null"]},
          "start_period": {"type": "integer", "minimum": 0},
          "end_period": {"type": ["integer", "null"], "minimum": 0},
          "parameters": {
            "type": "object",
            "additionalProperties": {"type": ["number", "string", "boolean", "null"]}
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "config": {"type": "object"}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "random_seed": {"type": "integer", "minimum": 0},
    "synthetic": {"type": "boolean"}
  }
}

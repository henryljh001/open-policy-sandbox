{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/policy-sandbox/schemas/aggregate_calibration_dataset.v2.schema.json",
  "title": "AggregateCalibrationDatasetV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "publication_class",
    "data_card",
    "source_manifest",
    "transformation_ledger",
    "records",
    "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "publication_class": {
      "type": "string",
      "enum": ["public_synthetic", "private_restricted", "public_aggregate"]
    },
    "data_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "title",
        "publisher",
        "source_kind",
        "authorization",
        "license",
        "geography",
        "coverage",
        "limitations",
        "synthetic"
      ],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "source_kind": {
          "type": "string",
          "enum": [
            "synthetic_fixture",
            "official_statistics",
            "administrative_aggregate",
            "research_aggregate"
          ]
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "responsible_party",
            "allowed_purposes",
            "expires_on",
            "public_outputs"
          ],
          "properties": {
            "status": {"enum": ["synthetic_fixture", "authorized"]},
            "responsible_party": {"type": "string", "minLength": 1},
            "allowed_purposes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "expires_on": {"type": ["string", "null"], "format": "date"},
            "public_outputs": {
              "enum": ["synthetic_only", "none", "aggregate_only", "approved_fields"]
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "terms_uri", "redistribution"],
          "properties": {
            "identifier": {"type": "string", "minLength": 1},
            "terms_uri": {"type": ["string", "null"]},
            "redistribution": {
              "enum": ["synthetic_fixture", "prohibited", "aggregate_only", "permitted"]
            }
          }
        },
        "geography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "region_id", "boundary_version", "caliber"],
          "properties": {
            "level": {
              "enum": ["synthetic_county", "county", "prefecture", "province", "national"]
            },
            "region_id": {"type": "string", "minLength": 1},
            "boundary_version": {"type": "string", "minLength": 1},
            "caliber": {"type": "string", "minLength": 1}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference_years", "indicator_ids"],
          "properties": {
            "reference_years": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 2000, "maximum": 2100}
            },
            "indicator_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "synthetic": {"type": "boolean"}
      }
    },
    "source_manifest": {
      "$ref": "source_manifest.schema.json"
    },
    "transformation_ledger": {
      "$ref": "transformation_ledger.schema.json"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "indicator_id",
          "value",
          "unit",
          "reference_year",
          "status",
          "source_id",
          "transformation_step_ids",
          "synthetic"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "indicator_id": {
            "enum": [
              "total_population",
              "urbanization_rate",
              "employment_rate",
              "debt_to_revenue",
              "education_capacity_per_1000",
              "health_capacity_per_1000",
              "housing_occupancy_rate",
              "used_construction_land"
            ]
          },
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "reference_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
          "status": {
            "enum": [
              "synthetic_observation",
              "official_observation",
              "provisional_observation",
              "revised_observation"
            ]
          },
          "source_id": {"type": "string", "minLength": 1},
          "transformation_step_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "synthetic": {"type": "boolean"}
        }
      }
    },
    "synthetic": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"synthetic": {"const": true}},
        "required": ["synthetic"]
      },
      "then": {
        "properties": {
          "publication_class": {"const": "public_synthetic"},
          "data_card": {
            "properties": {
              "source_kind": {"const": "synthetic_fixture"},
              "authorization": {
                "properties": {
                  "status": {"const": "synthetic_fixture"},
                  "public_outputs": {"const": "synthetic_only"}
                }
              },
              "license": {
                "properties": {"redistribution": {"const": "synthetic_fixture"}}
              },
              "geography": {"properties": {"level": {"const": "synthetic_county"}}},
              "synthetic": {"const": true}
            }
          },
          "source_manifest": {"properties": {"synthetic": {"const": true}}},
          "transformation_ledger": {"properties": {"synthetic": {"const": true}}},
          "records": {
            "items": {
              "properties": {
                "status": {"const": "synthetic_observation"},
                "synthetic": {"const": true}
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "publication_class": {"enum": ["private_restricted", "public_aggregate"]},
          "data_card": {
            "properties": {
              "source_kind": {
                "enum": ["official_statistics", "administrative_aggregate", "research_aggregate"]
              },
              "authorization": {
                "properties": {
                  "status": {"const": "authorized"},
                  "public_outputs": {"enum": ["none", "aggregate_only", "approved_fields"]}
                }
              },
              "license": {
                "properties": {
                  "redistribution": {"enum": ["prohibited", "aggregate_only", "permitted"]}
                }
              },
              "geography": {"properties": {"level": {"enum": ["county", "prefecture", "province", "national"]}}},
              "synthetic": {"const": false}
            }
          },
          "source_manifest": {"properties": {"synthetic": {"const": false}}},
          "transformation_ledger": {"properties": {"synthetic": {"const": false}}},
          "records": {
            "items": {
              "properties": {
                "status": {
                  "enum": ["official_observation", "provisional_observation", "revised_observation"]
                },
                "synthetic": {"const": false}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_class": {"const": "public_aggregate"}
        },
        "required": ["publication_class"]
      },
      "then": {
        "properties": {
          "data_card": {
            "properties": {
              "authorization": {
                "properties": {
                  "public_outputs": {
                    "enum": ["aggregate_only", "approved_fields"]
                  }
                }
              },
              "license": {
                "properties": {
                  "redistribution": {
                    "enum": ["aggregate_only", "permitted"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
